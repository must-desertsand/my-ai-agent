<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-launchd.sh fills in the absolute uv, repo and home paths. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.haseeb.agent.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>--project</string>
    <string>__REPO__</string>
    <string>haseeb-agent</string>
    <string>dashboard</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- A dashboard that cannot start (its port taken, say) is retried every 30 s, not every 10. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/haseeb-agent/dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/haseeb-agent/dashboard.err.log</string>
</dict>
</plist>
